{
  "mcpServers": {
    "cua": {
      "command": "python",
      "args": [
        "integrations/cua/mcp/cua_mcp_proxy.py",
        "--allow",
        "launch_app,list_windows,get_window_state,parse_visual_regions,click,type_text,press_key",
        "--strip-images",
        "--inline-structured",
        "--parse-min-confidence",
        "0.5",
        "--parse-max-regions",
        "150"
      ],
      "env": {
        "CUA_DRIVER_RS_TELEMETRY_ENABLED": "false"
      }
    }
  }
}
